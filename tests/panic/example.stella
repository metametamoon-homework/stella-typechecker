language core;

extend with #comparison-operators, #panic;

fn div(n : Nat) -> fn(Nat) -> Nat {
  return fn(m : Nat) {
    return if true then panic! else panic! // division is not implemented yet 😁
  };
}

fn main(n : Nat) -> Nat {
  return div(n)(0);
}
