language core;
extend with #exceptions, #open-variant-exceptions, #variants, #nested-function-declarations;

fn helper(n : Nat) -> Nat {
    exception variant error_code : Nat
    return n
}

fn main(n : Nat) -> Nat {
    return helper(n)
}
