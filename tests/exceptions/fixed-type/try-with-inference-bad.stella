language core;

extend with #exceptions, #exception-type-declaration, #natural-literals, #let-bindings;

exception type = Nat

fn main(n : Nat) -> Nat {
   return let x = try {
     if true then throw(0) else throw(1)
   } with {
     1
   } in x
}
