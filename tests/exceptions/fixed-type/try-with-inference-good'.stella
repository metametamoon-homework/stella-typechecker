/*
TEST_BEGIN
{
  "type": "stop-on-first-error",
  "expected-error": null
}
TEST_END
*/

language core;

extend with #exceptions, #exception-type-declaration, #natural-literals;

exception type = Nat

fn main(n : Nat) -> Nat {
   return let x = try {
     if true then 1 else throw(1)
   } with {
     1
   } in x
}
