/*
TEST_BEGIN
{
  "type": "stop-on-first-error",
  "expected-error": null
}
TEST_END
*/

language core;

extend with #exceptions, #exception-type-declaration, #natural-literals;

exception type = Nat

fn boo(n : Nat) -> Bool {
    return true
}

fn main(n : Nat) -> Bool {
   return let y = try {
     true
   } catch {
     x => boo(x)
   } in y
}
