language core;

fn main(x : <| inner : <| a : Nat, b : Bool |>, outer : Nat |>) -> Nat {
  return match x {
      <| inner = v |> => match v {
          <| a = n |> => n
        | <| b = flag |> => 0
      }
    | <| outer = n |> => n
  }
}
