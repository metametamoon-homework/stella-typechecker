language core;

extend with #records, #structural-subtyping;

fn some(
  f : fn({a : Nat}) -> {a : Nat},
  x : {a : Nat}
) -> {a : Nat, b : Nat} {
  return f(x)
}

fn main(n : Nat) -> Nat {
  return n
}
