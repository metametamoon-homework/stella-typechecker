language core;
extend with #references, #unit-type, #records, #structural-subtyping, #let-bindings;

fn use(r : &{a : Nat, b : Nat}) -> Unit {
    return unit
}

fn main(n : Nat) -> Unit {
    return let x = new({a = n}) in use(x)
}
