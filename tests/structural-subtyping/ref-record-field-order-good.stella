language core;
extend with #references, #unit-type, #records, #structural-subtyping;

fn use(r : &{a : Nat, b : Bool}) -> Unit {
    return unit
}

fn main(n : Nat) -> Unit {
    return let x = new({b = false, a = n}) in use(x)
}
