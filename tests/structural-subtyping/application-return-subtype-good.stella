language core;

extend with #records, #structural-subtyping;

fn some(
  f : fn({a : Nat, b : Nat}) -> {a : Nat, b : Nat}, 
  x : {a : Nat, b : Nat}
) -> {a : Nat} {
  return f(x)
}

fn main(n : Nat) -> Nat {
  return n
}
